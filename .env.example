# 复制为 .env 后填写真实值，不要把 .env 提交到仓库。
# 这里的环境变量会覆盖 config.yaml 中的同名字段。

# 语雀开放 API Token（必填）
YUQUE_TOKEN=

# 大模型密钥（必填）
LLM_API_KEY=

# 以下为可选
# 网页端会话凭据，仅在使用网页通道时需要
YUQUE_SESSION=
YUQUE_CTOKEN=

# 联网查释义时使用的代理，例如 http://127.0.0.1:7890
EXPLAIN_PROXY=

# 可选的 GitHub 备份令牌，仅当 backup.enabled 为 true 时需要
GITHUB_TOKEN=
